# Sentinel Hub OAuth client configured in your Copernicus Data Space dashboard.
# Export these in your shell before starting the server. Never commit secrets.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Historical ohsome v2 fallback needs a free HeiGIT API key when v1 is unavailable.
OHSOME_API_KEY=
# Optional output directory; defaults to data/runs in this checkout.
# FLOOD_LENS_DATA=/absolute/path/to/runs
# Optional Python module implementing model_info() and predict_water().
# Default adapter is a placeholder; threshold mode works without model weights.
# FLOOD_LENS_MODEL_ADAPTER=models.water_model
