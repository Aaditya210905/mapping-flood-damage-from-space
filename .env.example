# Sentinel Hub OAuth client configured in your Copernicus Data Space dashboard.
# Set these in the private .env loaded by ./run.sh, or export them. Never commit secrets.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Historical ohsome v2 fallback needs a free HeiGIT API key when v1 is unavailable.
OHSOME_API_KEY=
# Optional Groq copilot. Values are server-only; restart after editing .env.
LLM_ENABLED=false
GROQ_API_KEY=
# Alternative key name: LLM_API_KEY (takes precedence over GROQ_API_KEY).
LLM_MODEL=openai/gpt-oss-120b
# Groq SDK root URL, without /openai/v1 (the SDK supplies that path).
LLM_BASE_URL=https://api.groq.com
LLM_TIMEOUT_SECONDS=25
LLM_BUDGET_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=4096
LLM_REASONING_EFFORT=low
# Known questions retrieve evidence locally and need one generation request.
LLM_APPLICATION_RETRIEVAL=true
LLM_RETRIEVAL_ROUNDS=2
LLM_MAX_TOOL_CALLS=6
LLM_RETRIEVAL_PAGE_SIZE=5
# Retry only a short provider-specified delay within the overall budget.
LLM_MAX_RATE_LIMIT_RETRIES=1
LLM_MAX_RETRY_WAIT_SECONDS=3
# Larger matching lists are explicitly truncated with a full layer export.
COPILOT_MAX_LIST_RECORDS=1000
# Reuse validated wording only for identical evidence/run/language/history.
LLM_RESPONSE_CACHE_TTL_SECONDS=300
LLM_RESPONSE_CACHE_ENTRIES=64
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_QUEUE_WAIT_SECONDS=2
LLM_PROVIDER_COOLDOWN_SECONDS=30
# Configuration overrides are local files; restart after changing them.
# FLOOD_LENS_MAPPING_CONFIG=/absolute/path/to/mapping.toml
# FLOOD_LENS_ACQUISITION_CONFIG=/absolute/path/to/acquisition.toml
# FLOOD_LENS_PRESETS_FILE=/absolute/path/to/presets.json
# Optional output directory; defaults to data/runs in this checkout.
# FLOOD_LENS_DATA=/absolute/path/to/runs
